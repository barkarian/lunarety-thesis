\contentsline {figure}{\numberline {5.10}{\ignorespaces \xpg@aux {}{english}Μετατροπή δομής Rate.}}{53}{figure.caption.424}%
\contentsline {figure}{\numberline {5.11}{\ignorespaces \xpg@aux {}{english}Απομόνωση δεδομένων Multi-Tenant.}}{54}{figure.caption.442}%
\contentsline {figure}{\numberline {5.12}{\ignorespaces \xpg@aux {}{english}Διαχείριση ζωνών ώρας.}}{55}{figure.caption.470}%
\contentsline {figure}{\numberline {5.13}{\ignorespaces \xpg@aux {}{english}Στατιστικά Κώδικα.}}{56}{figure.caption.490}%
